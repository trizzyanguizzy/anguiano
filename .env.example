# Household login
MEALS_PASSCODE=               # the family passcode you type to unlock the app
MEALS_SESSION_SECRET=         # random 32+ chars; signs the login cookie

# Push notifications (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:anguiano.dev@gmail.com

# Vercel Cron sends this as a Bearer token
CRON_SECRET=

# Injected by the Upstash Redis integration in Vercel (either naming works)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
